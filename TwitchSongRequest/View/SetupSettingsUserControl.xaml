<UserControl
    x:Class="TwitchSongRequest.View.SetupSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:TwitchSongRequest.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Rectangle Fill="Black" Opacity="0.5" />
        <Border
            Width="600"
            Height="450"
            Background="{DynamicResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}"
            BorderBrush="{StaticResource TitleGradientBrush}"
            BorderThickness="4"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Background="{DynamicResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}">
                    <Label
                        Grid.Row="0"
                        Margin="32,8"
                        HorizontalAlignment="Center"
                        Content="Settings"
                        FontSize="16"
                        Foreground="WhiteSmoke" />
                    <Label
                        Grid.Row="0"
                        Margin="4,8,16,2"
                        Content="Connections"
                        Foreground="WhiteSmoke" />
                    <ListBox SelectedItem="{Binding TestSelectedItem, Mode=TwoWay}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" CommandParameter="{Binding SelectedItem.Content, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBox}}}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <ListBoxItem>Twitch Streamer</ListBoxItem>
                        <ListBoxItem>Twitch Bot</ListBoxItem>
                        <ListBoxItem>Spotify</ListBoxItem>
                    </ListBox>
                    <Label
                        Grid.Row="0"
                        Margin="4,8,16,2"
                        Content="Twitch"
                        Foreground="WhiteSmoke" />
                    <ListBox SelectedItem="{Binding TestSelectedItem, Mode=TwoWay}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" CommandParameter="{Binding SelectedItem.Content, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBox}}}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <ListBoxItem>Channel Points</ListBoxItem>
                        <ListBoxItem>Reply in Chat</ListBoxItem>
                        <ListBoxItem>Chat Commands</ListBoxItem>
                        <ListBoxItem>Song Blocklist</ListBoxItem>
                        <ListBoxItem>User Blocklist</ListBoxItem>
                    </ListBox>
                    <Label
                        Grid.Row="0"
                        Margin="4,8,16,2"
                        Content="App"
                        Foreground="WhiteSmoke" />
                    <ListBox SelectedItem="{Binding TestSelectedItem, Mode=TwoWay}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" CommandParameter="{Binding SelectedItem.Content, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBox}}}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <ListBoxItem>General</ListBoxItem>
                        <ListBoxItem>Playback</ListBoxItem>
                        <ListBoxItem>About</ListBoxItem>
                    </ListBox>
                </StackPanel>

                <Grid
                    Grid.Row="0"
                    Grid.Column="1"
                    Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}" />
                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Height="25"
                        Margin="0,0,24,0"
                        Command="{Binding ResetSetupSettingsCommand}"
                        Content="Reset" />
                    <Button
                        Grid.Column="2"
                        Height="25"
                        Margin="24,0,0,0"
                        Command="{Binding CloseSetupSettingsCommand}"
                        Content="Close" />
                    <Button
                        Grid.Column="3"
                        Height="25"
                        Margin="16,0,0,0"
                        Command="{Binding SaveSetupSettingsCommand}"
                        Content="Save"
                        Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
